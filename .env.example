# Copy to .env only for local development; never upload .env to GitHub.
# Choose a libSQL database in Turso (this adapter uses @libsql/client).
TURSO_DATABASE_URL=libsql://YOUR-DATABASE-YOUR-ORG.turso.io
TURSO_AUTH_TOKEN=PASTE_TOKEN_LOCALLY_ONLY
# Render provides its HTTPS address automatically via RENDER_EXTERNAL_URL.
# For a different host, set PUBLIC_ORIGIN=https://YOUR-ACTUAL-APP-ADDRESS
# Do not enable production locally unless an HTTPS origin is available.
# Optional social login. Set real values in Render > Environment, never in GitHub files.
# These must match the provider's Web application credentials and redirect URIs.
# PUBLIC_ORIGIN=https://dailytally-aaqk.onrender.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Copy the supported Graph API version shown by your Meta app, including the leading v.
FACEBOOK_GRAPH_VERSION=
# Optional one-time owner setup. Use Render Environment for real credentials.
ADMIN_PHONE=01913354321
ADMIN_EMAIL=ahroni.usa@gmail.com
# Existing account: use its current password. New account: choose 12–128 characters.
# Remove ADMIN_BOOTSTRAP_PASSWORD after successful setup; the database role persists.
ADMIN_BOOTSTRAP_PASSWORD=
